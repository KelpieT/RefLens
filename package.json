{
  "name": "reflens",
  "displayName": "RefLens",
  "description": "Shows Find All References in a sidebar TreeView, grouped by file, with kind markers (Def/Impl/Read/Write/Ref)",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reflens-container",
          "title": "RefLens",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "reflens-container": [
        {
          "id": "reflens.resultsView",
          "name": "References",
          "type": "webview",
          "contextualTitle": "RefLens References"
        }
      ]
    },
    "commands": [
      {
        "command": "reflens.findReferences",
        "title": "RefLens: Find References at Cursor",
        "icon": "$(references)"
      },
      {
        "command": "reflens.clearResults",
        "title": "RefLens: Clear Results",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reflens.findReferences",
          "when": "view == reflens.resultsView",
          "group": "navigation@1"
        },
        {
          "command": "reflens.clearResults",
          "when": "view == reflens.resultsView",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "reflens.findReferences",
          "group": "navigation",
          "when": "editorHasReferenceProvider"
        }
      ]
    },
    "configuration": {
      "title": "RefLens Settings",
      "properties": {
        "reflens.autoUpdate": {
          "type": "boolean",
          "default": false,
          "description": "Automatically update references when the cursor moves (debounced)"
        },
        "reflens.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "Debounce delay in milliseconds for auto-update on cursor move"
        },
        "reflens.maxSnippetLength": {
          "type": "number",
          "default": 120,
          "description": "Maximum character length of the inline code snippet shown per reference"
        },
        "reflens.deduplicateLines": {
          "type": "boolean",
          "default": false,
          "description": "Hide duplicate references that point to the same line in the same file (keeps the highest-priority kind)"
        },
        "reflens.collapseAll": {
          "type": "boolean",
          "default": false,
          "description": "Start with all file/kind groups collapsed when results are shown"
        },
        "reflens.showFullPath": {
          "type": "boolean",
          "default": false,
          "description": "Show full relative file path instead of just the filename in results"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run compile && vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.x"
  }
}
